# Cloudflare Pages cache headers
# Hashed assets (JS/CSS with content hash in filename) — cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html — do not cache (always refetch to pick up new deployments)
/index.html
  Cache-Control: no-cache

# All other static assets — long cache but revalidate
/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
